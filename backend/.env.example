# Required — Clerk Frontend API URL (derive from your pk_test_/pk_live_ key)
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# Database — pick ONE pattern:
#
# 1) Running the API directly on your machine (uvicorn / alembic CLI):
#    must match POSTGRES_USER/PASSWORD/DB below.
DATABASE_URL=postgresql://finhealth:devpassword@localhost:5432/fintech

# 2) Used by docker compose to provision Postgres and wire the API container.
POSTGRES_USER=finhealth
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=fintech

# Optional overrides
# CORS_ORIGINS=http://localhost:5173,https://yourdomain.com
# LOG_LEVEL=INFO
# WEB_CONCURRENCY=2

# LLM — Chatbot & Recommendations
# Provider: "ollama" (default, for local dev) or "openai" (OpenAI-compatible)
# LLM_PROVIDER=ollama
#
# Ollama settings (used when LLM_PROVIDER=ollama):
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3.5:0.8b
#
# OpenAI settings (used when LLM_PROVIDER=openai):
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
