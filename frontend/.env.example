# Required — your Clerk publishable key (Dashboard -> API Keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Optional — only needed when the frontend is deployed separately from the API.
# In local dev, leave this unset: calls go through the Vite dev proxy
# ("/api" on the same origin, forwarded to http://127.0.0.1:8000).
# VITE_API_BASE_URL=https://api.yourdomain.com
